# Meta Model API key from https://dev.meta.ai (Model API dashboard -> API keys).
# Format: LLM|{numeric_id}|{secret}. Server-side only; never exposed to the browser.
MODEL_API_KEY=

# Offline mock mode for LOCAL DEV ONLY. Returns canned responses and labels every
# call "MOCK" in the UI. Refused on Vercel production. The demo uses real calls.
MOCK_META=0
